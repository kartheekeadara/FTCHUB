// Copy to Secrets.xcconfig (gitignored) and set your Google iOS OAuth client.
// Must match GOOGLE_IOS_CLIENT_ID in FTCHUB/Resources/Secrets.plist.
//
// GOOGLE_IOS_CLIENT_ID = YOUR_ID.apps.googleusercontent.com
// GOOGLE_IOS_URL_SCHEME = com.googleusercontent.apps.YOUR_NUMERIC_PREFIX
// GOOGLE_WEB_CLIENT_ID = YOUR_WEB_ID.apps.googleusercontent.com

GOOGLE_IOS_CLIENT_ID = YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_IOS_URL_SCHEME = com.googleusercontent.apps.YOUR_NUMERIC_PREFIX
GOOGLE_WEB_CLIENT_ID = YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
