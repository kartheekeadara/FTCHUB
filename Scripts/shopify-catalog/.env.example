# Vendor Shopify source
# Example: gobilda.myshopify.com  or  shop.somestore.com
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2024-10

# Brand/vendor label written into every PartTemplate.manufacturer
MANUFACTURER_NAME=goBILDA

# Optional: restrict to a single collection handle (e.g. "ftc-legal")
# If set, only products in this collection are exported.
COLLECTION_HANDLE=

# Output
OUTPUT_DIR=./dist
MANIFEST_FILENAME=manifest.json
CHUNK_SIZE=0                  # 0 = single file; otherwise parts per chunk (e.g. 500)
BASE_IMAGE_URL=               # leave empty when product images use absolute URLs

# Optional upload target (Supabase Storage). Used by upload-manifest.js.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=catalog
SUPABASE_MANIFEST_PATH=parts/manifest.json
